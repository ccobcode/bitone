<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 气隙的前提:应用不能联网.tools:node="remove" 防止依赖合并进来,CheckManifestPermissions 再查一遍. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- 扫码是冷钱包唯一的输入方式. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 隐藏其他应用的悬浮窗. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- 自检读 Wi-Fi 开关,只读. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 自检要列出声明了悬浮窗权限的第三方应用,Android 11 起看不到别的包. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 硬件密钥的认证时间窗过期时,弹系统屏幕锁确认. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".BitOneApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="BitOne"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.BitOne"
        tools:ignore="UnusedAttribute">

        <!-- 配置变化不重建 Activity,秘密输入不经过 saved instance state.亲和性为空,别的应用不能把页面放进本应用的任务. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- EmojiCompat 启动时会去找可下载字体的提供方,离线设备不需要这次跨进程调用. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
